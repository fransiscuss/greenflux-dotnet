<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <AssemblyName>Greenflux.Sdk</AssemblyName>
    <RootNamespace>Greenflux</RootNamespace>
    <PackageId>GreenfluxDotNet.Sdk</PackageId>
    <Title>Greenflux .NET SDK</Title>
    <!-- Package metadata other than identity lives in Directory.Build.props. -->
    <Version>0.2.2</Version> <!-- x-release-please-version -->
    <Description>Unofficial typed .NET client for the Greenflux Platform, Charge Location Management, Remote Commands, and Charge Assist APIs.</Description>
    <PackageTags>greenflux;ev;charging;cpms;cpo;emsp;ocpi;smart-charging</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\..\docs\usage-examples.md" Pack="true" PackagePath="docs\" />
    <None Include="..\..\openapi\*.json" Pack="true" PackagePath="openapi\" />
  </ItemGroup>

</Project>
