root = true

# Models/ and Clients/ are hand-maintained, but their member names mirror the wire
# format of the four upstream APIs rather than .NET conventions:
#
#   * properties carry the API's snake_case field name (Report_id, Firmware_version)
#   * enum members carry the OCPI/vendor value name (CHADEMO, DOMESTIC_A)
#   * a few clients still throw argument exceptions the long way
#
# The enum names are deliberate - they match the published spec values. The property
# names are residue from the original scaffold and are worth renaming; every one of
# them already has an explicit [JsonProperty], so renaming the C# identifier does not
# change the wire contract. Tracked as a follow-up; suppressed here meanwhile so the
# rest of the analyzer set still applies to this code.
[src/Greenflux.Sdk/{Clients,Models}/**.cs]
dotnet_diagnostic.CA1707.severity = none  # underscores in member names
dotnet_diagnostic.CA1510.severity = none  # ArgumentNullException.ThrowIfNull
dotnet_diagnostic.CA1041.severity = none  # ObsoleteAttribute without a message
dotnet_diagnostic.CA1716.severity = none  # type name matching a reserved keyword
