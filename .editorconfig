root = true

# Member names in Models/ and Clients/ mirror the wire contract of the four upstream
# APIs rather than .NET conventions, and cannot be renamed without breaking it:
#
#   * enum members carry the published spec value (CHADEMO, DOMESTIC_A, AC_3_PHASE)
#   * client methods carry the API's operation id (Locations_GetById)
#
# Property names were the one part of this that was only scaffold residue, and they
# have been renamed to PascalCase - the wire names live in [JsonPropertyName].
[src/Greenflux.Sdk/{Clients,Models}/**.cs]
dotnet_diagnostic.CA1707.severity = none  # underscores in member names
dotnet_diagnostic.CA1510.severity = none  # ArgumentNullException.ThrowIfNull
dotnet_diagnostic.CA1041.severity = none  # ObsoleteAttribute without a message
dotnet_diagnostic.CA1716.severity = none  # type name matching a reserved keyword
